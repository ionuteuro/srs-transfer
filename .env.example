# Configurează un token lung și unic înainte de a expune panoul admin.
ADMIN_TOKEN=

# Notificari (email + SMS) la fiecare programare noua.
# Lasa gol pentru modul mock (se afiseaza in consola).
ADMIN_EMAIL=
ADMIN_PHONE=

# Email prin SMTP (ex. Mailtrap, Gmail, Postmark)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SRS Transfer <contact@srs-transfer.ro>

# SMS prin Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

PORT=3001
DB_PATH=

# Agent conversațional (opțional; fără cheie folosește FAQ local).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
