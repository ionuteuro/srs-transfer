# Configurare integrari Netopia (mobilPay) - clasic / hosted redirect
# Lasa gol pentru modul MOCK (plata simulata in dev).

# Signature-ul contului tau Netopia (ex. XXXXX-XXXXX)
NETOPIA_SIGNATURE=

# Cale catre certificatul public (.cer) primit de la Netopia
NETOPIA_CERT=

# Cale catre cheia privata (.pem) corespunzatoare (pentru decriptarea IPN)
NETOPIA_KEY=

# true = sandbox Netopia, false = productie
NETOPIA_SANDBOX=true

# URL public accesibil de Netopia pentru IPN/return (ex. https://domeniu.ro)
# Daca lipseste, se deduce din request.
PUBLIC_BASE=

# Notificari (email + SMS) la fiecare programare noua.
# Lasa gol pentru modul mock (se afiseaza in consola).
ADMIN_EMAIL=
ADMIN_PHONE=

# Email prin SMTP (ex. Mailtrap, Gmail, Postmark)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SRS Transfer <contact@srs-transfer.ro>

# SMS prin Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

PORT=3001
